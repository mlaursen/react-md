{
  "name": "@react-md/vite-material-symbols-plugin",
  "version": "2.1.3",
  "description": "A vite plugin for react-md that automatically adds the material symbols link in the base html",
  "keywords": [
    "material symbol",
    "material symbols",
    "react-md",
    "vite"
  ],
  "bugs": {
    "url": "https://github.com/mlaursen/react-md/issues"
  },
  "license": "MIT",
  "author": "Mikkel Laursen <mlaursen03@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlaursen/react-md.git",
    "directory": "packages/vite-material-symbols-plugin"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean-dist": "rm -rf dist types",
    "clean-cache": "rm -rf .turbo node_modules",
    "clean": "concurrently 'pnpm clean-dist' 'pnpm clean-cache'",
    "lint": "NODE_ENV=production eslint .",
    "lint-fix": "pnpm lint --fix",
    "typecheck": "tsgo --noEmit",
    "typecheck-watch": "pnpm typecheck --watch",
    "test": "vitest",
    "test-run": "vitest run",
    "test-coverage": "vitest --coverage",
    "test-run-coverage": "pnpm test-run --coverage",
    "test-run-snapshot": "pnpm test-run -u",
    "build-dist": "rollup -c rollup.config.ts",
    "build-dist-watch": "pnpm build-dist --watch",
    "build-types": "tsgo -p tsconfig.types.json",
    "build-types-watch": "pnpm build-types --watch",
    "build": "pnpm build-types && pnpm build-dist"
  },
  "dependencies": {
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@react-md/core": "workspace:*",
    "@react-md/eslint-config": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^24.12.2",
    "@typescript/native-preview": "beta",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-swc3": "^0.12.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@react-md/core": "workspace:*",
    "react-md": "workspace:*",
    "vite": ">= 7"
  },
  "peerDependenciesMeta": {
    "@react-md/core": {
      "optional": true
    },
    "react-md": {
      "optional": true
    },
    "vite": {
      "optional": false
    }
  },
  "packageManager": "pnpm@10.33.0"
}
