{
  "name": "mlaursen-vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "check-format": "oxfmt --check",
    "format": "oxfmt",
    "lint": "NODE_ENV=production eslint .",
    "lint-fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "typecheck-watch": "pnpm typecheck --watch",
    "test": "vitest",
    "test-run": "vitest run",
    "test-coverage": "vitest --coverage",
    "test-run-coverage": "pnpm test-run --coverage",
    "test-run-snapshot": "pnpm test-run -u",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-md/core": "^7.0.5",
    "@react-md/material-icons": "^7.0.6",
    "cnbuilder": "^3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@mlaursen/eslint-config": "^12.0.9",
    "@react-md/vite-material-symbols-plugin": "^2.1.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.0.4",
    "sass-embedded": "^1.99.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.6",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
