{
  "name": "vite-playground",
  "version": "0.0.6",
  "private": true,
  "license": "MIT",
  "author": "Mikkel Laursen <mlaursen03@gmail.com>",
  "type": "module",
  "scripts": {
    "clean-dist": "rm -rf dist",
    "clean-cache": "rm -rf .turbo node_modules",
    "clean": "concurrently 'pnpm clean-dist' 'pnpm clean-cache'",
    "lint": "NODE_ENV=production eslint .",
    "lint-fix": "pnpm lint --fix",
    "typecheck": "tsgo --noEmit",
    "typecheck-watch": "pnpm typecheck --watch",
    "test": "vitest",
    "test-run": "vitest run",
    "test-coverage": "vitest --coverage",
    "test-run-coverage": "pnpm test-run --coverage",
    "test-run-snapshot": "pnpm test-run -u",
    "dev": "vite",
    "build": "tsgo -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-md/code": "workspace:*",
    "@react-md/core": "workspace:*",
    "@react-md/material-icons": "workspace:*",
    "cnbuilder": "^3.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@react-md/eslint-config": "workspace:*",
    "@react-md/vite-material-symbols-plugin": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "beta",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.4",
    "sass-embedded": "^1.104.1",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
