{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "types/**"]
    },
    "lint": {},
    "lint-fix": {},
    "typecheck": {},
    "test": {
      "interactive": true,
      "cache": false
    },
    "test-run": {
      "dependsOn": ["^build"]
    },
    "test-coverage": {
      "interactive": true,
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "test-run-coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test-run-snapshot": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "clean-dist": {
      "cache": false
    }
  }
}
